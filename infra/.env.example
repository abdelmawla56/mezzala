# Copy with `make env` (random passwords). Never commit .env.
PGPASSWORD=change-me                # superuser/owner: migrations, seeding, test cleanup ONLY
MZ_APP_PASSWORD=change-me           # mz_app: what the web app connects as
MZ_WORKER_PASSWORD=change-me        # mz_worker: media worker, two tables only

# App-side URLs (host ports). Put these in apps/web/.env.local
DATABASE_URL=postgres://mz_app:${MZ_APP_PASSWORD}@localhost:5442/mezzala_gclub
DATABASE_URL_OWNER=postgres://mezzala:${PGPASSWORD}@localhost:5442/mezzala_gclub

# Object storage (MinIO in dev; AWS S3 eu-central-1 later, after DEC-017 + counsel + media ADR)
S3_BUCKET=mezzala-media
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=mezzala
S3_SECRET_KEY=change-me
S3_REGION=eu-central-1
S3_FORCE_PATH_STYLE=true
WEB_ORIGIN=http://localhost:3600
MZ_STORAGE=s3                       # s3 | local (local = today's media-local/ adapter)
MZ_MEDIA_SECRET=change-me           # only used by the local adapter
